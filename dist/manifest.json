{
  "manifest_version": 3,
  "name": "Element Attribute Viewer",
  "version": "1.0.0",
  "description": "Click on any element to view its attributes",
  "permissions": [
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
